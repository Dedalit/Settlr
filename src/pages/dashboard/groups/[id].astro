---
import Layout from '@/layouts/Layout.astro';
import { getServerUser } from '@/lib/user';
import { DashboardLayout } from "@/components/dashboard-layout";
import { GroupDetail } from "@/components/pages/group-page";

const rawId = Astro.params.id;
if (!rawId) {
  return Astro.redirect('/dashboard');
}
const id: string = String(rawId);

const userData = await getServerUser({ request: Astro.request, cookies: Astro.cookies });
if (!userData) return Astro.redirect('/auth/signin');
---

<Layout>
  <DashboardLayout client:load user={userData}>
    <GroupDetail client:load id={id} />
  </DashboardLayout>
</Layout>
